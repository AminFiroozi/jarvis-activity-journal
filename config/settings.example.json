{
  "sampleIntervalSeconds": 60,
  "titleMaxLength": 180,
  "retentionDays": 90,
  "privacy": {
    "captureEnabled": true,
    "privateModeHotkey": "Ctrl+Alt+Pause",
    "excludedApplications": [],
    "excludedWindowTitlePatterns": [],
    "redactBeforeStorage": true,
    "retentionDays": 14,
    "deleteRawScreenshotsAfterAnalysis": false
  },
  "projectPaths": [
    "C:\\Users\\YourName\\Projects"
  ],
  "redactTitlePatterns": [
    "password",
    "secret",
    "token",
    "api[ _-]?key",
    "credential",
    "private key"
  ],
  "contentCapture": {
    "enabled": true,
    "maxTextLength": 12000,
    "maxElementCount": 120,
    "allowedProcessNames": [
      "Doolgram",
      "chrome",
      "msedge",
      "firefox",
      "Code",
      "Code - Insiders",
      "WindowsTerminal",
      "pwsh"
    ],
    "redactTextPatterns": [
      "(?i)password\\s*[:=]\\s*[^\\s]+",
      "(?i)(api[_ -]?key|token|secret)\\s*[:=]\\s*[^\\s]+"
    ]
  },
  "screenshotAnalyzer": {
    "enabled": false,
    "repositoryPath": "C:\\Path\\To\\jarvis-activity-journal",
    "endpoint": "http://localhost:11434/v1/chat/completions",
    "model": "llava",
    "apiKeyEnv": "VISION_API_KEY",
    "maxScreenshotsPerRun": 12
  },
  "journalSynthesis": {
    "enabled": true,
    "repositoryPath": "C:\\Path\\To\\jarvis-activity-journal",
    "endpoint": "http://localhost:1234/v1/chat/completions",
    "model": "qwen2.5-vl",
    "apiKeyEnv": "VISION_API_KEY"
  }
}
